/*
 * Dark Theme for NHJS_N — вариант C
 *
 * Пересобрана палитра: один бирюзовый акцент вместо пяти кричащих цветов,
 * спокойные поверхности вместо кислотной зелёной заливки полей,
 * красный остался только для опасных действий и конфликтов.
 *
 * Generated from the previous theme by assets/styles palette migration;
 * see docs/WAL.md.
 */


/* === GLOBAL STYLES === */
QMainWindow, QWidget {
    background-color: #16181b;
    color: #dfe3e8;
    font-family: "Segoe UI", "Roboto", sans-serif;
    font-size: 14px;
}

/* === MAIN WINDOW === */
QMainWindow {
    background-color: #101214;
}

QMainWindow::separator {
    background-color: #2a2f35;
    width: 2px;
    height: 2px;
}

/* === TABS === */
QTabWidget::pane {
    border: 1px solid #2a2f35;
    background-color: #16181b;
    border-radius: 5px;
}

QTabBar::tab {
    background-color: #232830;
    color: #9aa4b2;
    padding: 8px 16px;
    border: 1px solid #2a2f35;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background-color: #16181b;
    color: #e8edf2;
    border-bottom: 2px solid #39414a;
}

QTabBar::tab:hover {
    background-color: #343b43;
    color: #e8edf2;
}

/* === BUTTONS === */
QPushButton {
    background-color: #262b31;
    color: #e8edf2;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: bold;
    min-width: 80px;
}

QPushButton:hover {
    background-color: #6200ee;
}

QPushButton:pressed {
    background-color: #262b31;
}

QPushButton:disabled {
    background-color: #2f353c;
    color: #79838f;
}

/* Primary buttons */
QPushButton#btn_auto, QPushButton#btn_export {
    background-color: #4db6ac;
    color: #0b0c0d;
}

QPushButton#btn_auto:hover, QPushButton#btn_export:hover {
    background-color: #2f6f68;
}

/* Danger buttons */
QPushButton#btn_clear, QPushButton#btn_delete {
    background-color: #8c4a4e;
    color: #0b0c0d;
}

QPushButton#btn_clear:hover, QPushButton#btn_delete:hover {
    background-color: #3a1f22;
}

/* === INPUTS === */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #232830;
    border: 1px solid #2f353c;
    border-radius: 4px;
    padding: 6px 10px;
    color: #dfe3e8;
    selection-background-color: #262b31;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border: 1px solid #4db6ac;
}

QLineEdit:disabled, QTextEdit:disabled {
    background-color: #2f353c;
    color: #79838f;
}

/* === COMBOBOX === */
QComboBox {
    background-color: #232830;
    border: 1px solid #2f353c;
    border-radius: 4px;
    padding: 6px 10px;
    color: #dfe3e8;
}

QComboBox:hover {
    border: 1px solid #4db6ac;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #dfe3e8;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #232830;
    border: 1px solid #2f353c;
    selection-background-color: #262b31;
    color: #dfe3e8;
}

QComboBox QAbstractItemView::item {
    min-height: 30px;
    padding: 4px 8px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: #343b43;
}

/* === CHECKBOX === */
QCheckBox {
    color: #dfe3e8;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #2f353c;
    border-radius: 3px;
    background-color: #232830;
}

QCheckBox::indicator:checked {
    background-color: #4db6ac;
    border-color: #4db6ac;
}

QCheckBox::indicator:hover {
    border-color: #4db6ac;
}

/* === RADIO BUTTON === */
QRadioButton {
    color: #dfe3e8;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 18px;
    height: 18px;
    border: 2px solid #2f353c;
    border-radius: 10px;
    background-color: #232830;
}

QRadioButton::indicator:checked {
    background-color: #4db6ac;
    border-color: #4db6ac;
}

QRadioButton::indicator:hover {
    border-color: #4db6ac;
}

/* === SLIDER === */
QSlider::groove:horizontal {
    background-color: #2f353c;
    height: 6px;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background-color: #4db6ac;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background-color: #2f6f68;
}

QSlider::sub-page:horizontal {
    background-color: #4db6ac;
    border-radius: 3px;
}

/* === PROGRESS BAR === */
QProgressBar {
    background-color: #2f353c;
    border: none;
    border-radius: 4px;
    height: 8px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #4db6ac;
    border-radius: 4px;
}

/* === TABLES === */
QTableWidget {
    background-color: #16181b;
    alternate-background-color: #1b1e22;
    border: 1px solid #2a2f35;
    border-radius: 5px;
    gridline-color: #2a2f35;
    selection-background-color: #262b31;
}

QTableWidget::item {
    padding: 6px;
    border: none;
}

QTableWidget::item:hover {
    background-color: #232830;
}

QTableWidget::item:selected {
    background-color: #262b31;
    color: #e8edf2;
}

QHeaderView::section {
    background-color: #232830;
    color: #9aa4b2;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #2a2f35;
    font-weight: bold;
}

/* === TREE WIDGET === */
QTreeWidget {
    background-color: #16181b;
    border: 1px solid #2a2f35;
    border-radius: 5px;
    selection-background-color: #262b31;
}

QTreeWidget::item {
    padding: 4px;
    border: none;
}

QTreeWidget::item:hover {
    background-color: #232830;
}

QTreeWidget::item:selected {
    background-color: #262b31;
    color: #e8edf2;
}

/* === LIST WIDGET === */
QListWidget {
    background-color: #16181b;
    border: 1px solid #2a2f35;
    border-radius: 5px;
    selection-background-color: #262b31;
}

QListWidget::item {
    padding: 6px;
    border: none;
}

QListWidget::item:hover {
    background-color: #232830;
}

QListWidget::item:selected {
    background-color: #262b31;
    color: #e8edf2;
}

/* === SCROLL AREA === */
QScrollArea {
    background-color: #16181b;
    border: none;
}

QScrollBar:vertical {
    background-color: #232830;
    width: 12px;
    border-radius: 6px;
}

QScrollBar::handle:vertical {
    background-color: #414a54;
    min-height: 30px;
    border-radius: 6px;
}

QScrollBar::handle:vertical:hover {
    background-color: #5b636c;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background-color: #232830;
    height: 12px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal {
    background-color: #414a54;
    min-width: 30px;
    border-radius: 6px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #5b636c;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0px;
}

/* === GROUP BOX === */
QGroupBox {
    background-color: #1b1e22;
    border: 1px solid #2a2f35;
    border-radius: 5px;
    margin-top: 10px;
    padding-top: 10px;
    font-weight: bold;
    color: #4db6ac;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
    background-color: #1b1e22;
    color: #4db6ac;
}

/* === LABEL === */
QLabel {
    background-color: transparent;
    color: #dfe3e8;
}

QLabel#header, QLabel#title {
    font-size: 18px;
    font-weight: bold;
    color: #4db6ac;
}

/* === SPIN BOX === */
QSpinBox, QDoubleSpinBox {
    background-color: #232830;
    border: 1px solid #2f353c;
    border-radius: 4px;
    padding: 4px;
    color: #dfe3e8;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 1px solid #4db6ac;
}

QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    background-color: #2f353c;
    border: none;
    width: 16px;
}

QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover {
    background-color: #414a54;
}

/* === MENU BAR === */
QMenuBar {
    background-color: #101214;
    color: #dfe3e8;
    border-bottom: 1px solid #2a2f35;
}

QMenuBar::item {
    padding: 6px 12px;
    background-color: transparent;
}

QMenuBar::item:selected {
    background-color: #262b31;
}

QMenuBar::item:pressed {
    background-color: #262b31;
}

/* === MENU === */
QMenu {
    background-color: #232830;
    border: 1px solid #2f353c;
    border-radius: 4px;
    padding: 4px;
}

QMenu::item {
    padding: 6px 24px;
}

QMenu::item:selected {
    background-color: #262b31;
}

QMenu::separator {
    height: 1px;
    background-color: #2f353c;
    margin: 4px 8px;
}

/* === STATUS BAR === */
QStatusBar {
    background-color: #101214;
    color: #9aa4b2;
    border-top: 1px solid #2a2f35;
}

/* === TOOL TIP === */
QToolTip {
    background-color: #2f353c;
    color: #dfe3e8;
    border: 1px solid #414a54;
    border-radius: 4px;
    padding: 4px 8px;
}

/* === SPLITTER === */
QSplitter::handle {
    background-color: #2a2f35;
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #4db6ac;
}

/* === FRAME === */
QFrame {
    background-color: #1b1e22;
    border: 1px solid #2a2f35;
    border-radius: 5px;
}

QFrame#info_frame {
    background-color: #232830;
    border: 1px solid #2a3038;
}

/* === MESSAGE BOX === */
QMessageBox {
    background-color: #16181b;
}

QMessageBox QLabel {
    color: #dfe3e8;
}

QMessageBox QPushButton {
    min-width: 80px;
}

/* === DIALOG === */
QDialog {
    background-color: #16181b;
}

QDialogButtonBox {
    button-layout: 2; /* Center buttons */
}

/* === CALENDAR === */
QCalendarWidget {
    background-color: #16181b;
    border: 1px solid #2a2f35;
}

QCalendarWidget QMenu {
    background-color: #232830;
}

QCalendarWidget QSpinBox {
    background-color: #232830;
}

/* === SPECIFIC CLASSES === */

/* Assignment cells */
AssignmentCell {
    text-align: center;
    padding: 4px 8px;
    border: 1px solid #39414a;
    border-radius: 3px;
    background-color: #232830;
    font-size: 12px;
}

AssignmentCell:hover {
    background-color: #2a3038;
    border-color: #4db6ac;
}

/* Conflict cells */
AssignmentCell[has_conflict="true"] {
    border: 1px solid #8c4a4e;
    background-color: #3a1f22;
}

AssignmentCell[has_conflict="true"]:hover {
    background-color: #8c4a4e;
}

/* === MATERIAL DESIGN ACCENTS === */
/* Use these for custom styled elements */
#accent_primary {
    background-color: #4db6ac;
}

#accent_secondary {
    background-color: #2f6f68;
}

#accent_error {
    background-color: #8c4a4e;
}

#accent_surface {
    background-color: #232830;
}

#accent_on_primary {
    color: #0b0c0d;
}

#accent_on_secondary {
    color: #e8edf2;
}

/* === HEADER LABELS === */
QLabel#headerLabel {
    font-size: 16px;
    font-weight: bold;
    color: #4db6ac;
}

/* === SCHEDULE VIEW === */
QTreeWidget#scheduleTree {
    background-color: #16181b;
    border: 1px solid #2a2f35;
    border-radius: 5px;
}

QScrollArea#scheduleScroll {
    border: none;
    background-color: #16181b;
}

/* === ASSIGNMENT CELLS === */
QPushButton#assignmentCellFilled {
    text-align: left;
    padding: 1px 10px;
    background-color: #232830;
    border: 2px solid #39414a;
    border-radius: 4px;
    font-size: 14px;
    color: #a5d6a7;
}

QPushButton#assignmentCellFilled:hover {
    background-color: #2a3038;
}

QPushButton#assignmentCellEmpty {
    text-align: left;
    padding: 1px 10px;
    background-color: #232830;
    border: 2px solid #414a54;
    border-radius: 4px;
    font-size: 14px;
    color: #888888;
}

QPushButton#assignmentCellEmpty:hover {
    background-color: #343b43;
    border-color: #4db6ac;
}

QPushButton#assignmentCellConflict {
    text-align: left;
    padding: 1px 10px;
    background-color: #4a1a1a;
    border: 2px solid #5c2a2c;
    border-radius: 4px;
    font-size: 14px;
    color: #f2d7d8;
    font-weight: bold;
}

QPushButton#assignmentCellConflict:hover {
    background-color: #5a2a2a;
}

QPushButton#assignmentCellWaiting {
    text-align: left;
    padding: 1px 10px;
    background-color: #3d3810;
    border: 2px solid #fdd835;
    border-radius: 4px;
    font-size: 14px;
    color: #fff59d;
}

QPushButton#assignmentCellWaiting:hover {
    background-color: #4a4416;
}

QPushButton#assignmentCellConfirmed {
    text-align: left;
    padding: 1px 10px;
    background-color: #1f5530;
    border: 2px solid #81c784;
    border-radius: 4px;
    font-size: 14px;
    color: #c8e6c9;
    font-weight: bold;
}

QPushButton#assignmentCellConfirmed:hover {
    background-color: #276338;
}

/* === TOOLBAR BUTTONS === */
QPushButton#btnAddYear {
    background-color: #232830;
    color: #9aa4b2;
    border: 1px solid #444444;
    border-radius: 4px;
    padding: 4px;
}

QPushButton#btnAddYear:hover {
    background-color: #343b43;
}

/* === PARTICIPANTS TAB === */
QLabel#participantsTitle {
    font-size: 17px;
    font-weight: bold;
    color: #80cbc4;
    background: transparent;
    border: none;
}

QLineEdit#participantsSearch {
    background-color: #262b31;
    border: 1px solid #343b43;
    border-radius: 4px;
    padding: 5px 8px;
}

QWidget#participantsToolbar QPushButton#btnAdd {
    background-color: #2f6f68;
    color: #e8edf2;
    border-color: #2f6f68;
    font-weight: bold;
}

QWidget#participantsToolbar QPushButton#btnAdd:hover {
    background-color: #38857c;
}

QWidget#participantsToolbar QPushButton#btnDelete:hover {
    background-color: #5c2a2c;
    color: #ffcdd2;
    border-color: #7a3a3d;
}

QTableWidget#participantsTable::item {
    padding: 4px 10px;
}

/* === SCHEDULE TOOLBAR ===
   Нейтральные кнопки; цветом выделено только авто-распределение,
   «Очистить» краснеет при наведении. */
QWidget#scheduleToolbar QPushButton,
QWidget#participantsToolbar QPushButton,
QWidget#scheduleToolbar QToolButton,
QWidget#participantsToolbar QToolButton {
    background-color: #262b31;
    color: #e8edf2;
    border: 1px solid #343b43;
    border-radius: 4px;
    padding: 5px 12px;
    min-width: 0px;
    min-height: 22px;
    font-weight: normal;
}

QWidget#scheduleToolbar QPushButton:hover,
QWidget#participantsToolbar QPushButton:hover,
QWidget#scheduleToolbar QToolButton:hover,
QWidget#participantsToolbar QToolButton:hover {
    background-color: #2f353c;
}

QWidget#scheduleToolbar QPushButton:pressed,
QWidget#participantsToolbar QPushButton:pressed,
QWidget#scheduleToolbar QToolButton:pressed,
QWidget#participantsToolbar QToolButton:pressed {
    background-color: #22262b;
}

QWidget#scheduleToolbar QPushButton:disabled,
QWidget#participantsToolbar QPushButton:disabled {
    background-color: #22262b;
    color: #5d6670;
}

QWidget#scheduleToolbar QPushButton[iconButton="true"] {
    padding: 5px 0px;
    min-width: 32px;
    max-width: 32px;
    font-size: 15px;
}

QWidget#scheduleToolbar QPushButton#btnToggleSidebar:checked {
    background-color: #1e3a3a;
}

QWidget#scheduleToolbar QPushButton#btnAuto {
    background-color: #2f6f68;
    color: #e8edf2;
    border-color: #2f6f68;
    font-weight: bold;
}

QWidget#scheduleToolbar QPushButton#btnAuto:hover {
    background-color: #38857c;
}

QWidget#scheduleToolbar QPushButton#btnClear:hover {
    background-color: #5c2a2c;
    color: #ffcdd2;
    border-color: #7a3a3d;
}

QWidget#scheduleToolbar QPushButton#btnMore::menu-indicator {
    width: 0px;
}

QWidget#scheduleToolbar QToolButton#btnNotify {
    padding-right: 22px;
}

QWidget#scheduleToolbar QToolButton#btnNotify::menu-button {
    border-left: 1px solid #343b43;
    width: 18px;
}

/* === HISTORY VIEW === */
QFrame#infoFrame {
    background-color: #1e3a3a;
    border: 1px solid #2d5a5a;
    border-radius: 5px;
}

QLabel#infoNameLabel {
    font-size: 16px;
    font-weight: bold;
    color: #4db6ac;
}

QLabel#statsLabel {
    font-size: 12px;
    color: #9aa4b2;
}

/* === WORKBOOK VIEW === */
QLabel#descLabel {
    color: #9aa4b2;
    margin-bottom: 10px;
}

QPushButton#btnImport {
    background-color: #00796b;
    color: #e8edf2;
    padding: 10px;
    border-radius: 5px;
    font-weight: bold;
}

QPushButton#btnImport:hover {
    background-color: #004d40;
}

QLabel#fileLabel {
    color: #dfe3e8;
    margin-top: 10px;
}

QTextEdit#logWidget {
    background-color: #232830;
    border: 1px solid #2f353c;
    border-radius: 5px;
    color: #dfe3e8;
}

/* === SETTINGS VIEW === */
QPushButton#btnSaveSettings {
    background-color: #38857c;
    color: #e8edf2;
    padding: 10px;
    font-weight: bold;
    border-radius: 4px;
}

QPushButton#btnSaveSettings:hover {
    background-color: #006666;
}

/* === ASSIGNMENT CONFIG VIEW === */
QLabel#infoLabel {
    color: #9aa4b2;
    font-weight: bold;
    margin-bottom: 10px;
}

QPushButton#btnSaveConfig {
    background-color: #2a3038;
    color: #e8edf2;
    padding: 10px;
    font-weight: bold;
    border-radius: 4px;
}

QPushButton#btnSaveConfig:hover {
    background-color: #232830;
}

/* Schedule header label */
QLabel#scheduleHeaderLabel {
    font-size: 16px;
    font-weight: bold;
    color: #4db6ac;
}

/* Empty state label */
QLabel#emptyStateLabel {
    font-size: 16px;
    color: #888;
    padding: 40px;
}

/* === PARTICIPANTS VIEW === */
QPushButton#btnAdd {
    background-color: #38857c;
    color: #e8edf2;
    border-radius: 4px;
    padding: 5px 10px;
    font-weight: bold;
}

QPushButton#btnAdd:hover {
    background-color: #006064;
}

QPushButton#btnDelete {
    color: #f2d7d8;
}
/* === SCHEDULE WIDGETS === */
QLabel#scheduleWeekLabel {
    font-size: 14px;
    color: #9aa4b2;
}

QWidget#scheduleMeetingSection {
    background: #232830;
    border: 1px solid #2f353c;
    border-radius: 8px;
}

QLabel#scheduleMeetingHeader {
    font-weight: bold;
    color: #4db6ac;
    background: transparent;
    border: none;
}

QPushButton#schedulePositionCell {
    text-align: left;
    padding: 6px 10px;
    background: #232830;
    border: 1px solid #2f353c;
    border-radius: 4px;
    font-size: 14px;
    color: #dfe3e8;
}

QPushButton#schedulePositionCell:hover {
    background: #343b43;
    border-color: #4db6ac;
}

QPushButton#btnAutoSchedule {
    background: #ffa726;
    color: #e8edf2;
    border: none;
    border-radius: 4px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton#btnAutoSchedule:hover {
    background: #ffa726;
}

/* === ДОБАВЛЕНО В ВАРИАНТЕ C === */

/* --- Блок объявления: раньше был зашит белым фоном в коде --- */
QGroupBox#announcementGroup {
    font-weight: bold;
    font-size: 12px;
    color: #9aa4b2;
    border: 1px solid #2a2f35;
    border-radius: 6px;
    margin-top: 10px;
    padding: 10px;
    padding-top: 18px;
    background-color: #16181b;
}

QTextEdit#announcementEditor {
    background-color: #1b1e22;
    color: #e2e7ec;
    border: 1px solid #343b43;
    border-radius: 4px;
    padding: 6px;
}

QTextEdit#announcementEditor:focus {
    border: 1px solid #4db6ac;
}

QToolButton#announcementExpandToggle {
    background-color: transparent;
    border: 1px solid #343b43;
    border-radius: 4px;
    color: #9aa4b2;
    padding: 3px 10px;
}

QToolButton#announcementExpandToggle:hover {
    background-color: #22262b;
    color: #dfe3e8;
}

/* --- Заголовок недели и чтение из Библии --- */
QLabel#scheduleHeaderLabel {
    color: #4db6ac;
    font-weight: bold;
}

QLabel#bibleReadingLabel {
    color: #9aa4b2;
}

QLabel#weekSummary {
    color: #cfd6de;
}

QLabel#headerLabel {
    color: #4db6ac;
    font-weight: bold;
    font-size: 15px;
}

QLabel#emptyStateLabel {
    color: #79838f;
}

/* --- Ячейки конфликтов --- */
QPushButton#assignmentCellConflict {
    background-color: #3a1f22;
    border: 1px solid #8c4a4e;
    border-left: 3px solid #c26a6e;
    color: #f2d7d8;
}

QPushButton#assignmentCellConflict:hover {
    background-color: #4a2528;
}

/* --- Прочее, чего не было в базовой теме --- */
QSpinBox, QDoubleSpinBox, QTimeEdit {
    background-color: #1b1e22;
    color: #e2e7ec;
    border: 1px solid #343b43;
    border-radius: 4px;
    padding: 3px 6px;
}

QSpinBox:focus, QDoubleSpinBox:focus, QTimeEdit:focus {
    border: 1px solid #4db6ac;
}

QComboBox QAbstractItemView {
    background-color: #1b1e22;
    color: #dfe3e8;
    border: 1px solid #343b43;
    selection-background-color: #2a3138;
}

QListWidget, QListView {
    background-color: #1b1e22;
    border: 1px solid #2a2f35;
    color: #dfe3e8;
}

QListWidget::item:selected {
    background-color: #2a3138;
}

/* === WEEK HEADER (одна строка над таблицей расписания) ===
   Общее правило QFrame рисует рамку и у QLabel — здесь она не нужна. */
QWidget#weekHeader QLabel {
    border: none;
    background: transparent;
}

QWidget#weekHeader QLabel#bibleReadingLabel {
    color: #9aa4b2;
    font-size: 14px;
}

QWidget#weekHeader QLabel#weekStats {
    color: #ffb74d;
    font-weight: bold;
}

QWidget#weekHeader QLabel#weekStats[complete="true"] {
    color: #81c784;
}

QWidget#weekHeader QLabel#weekBadge {
    background-color: #1e3a5f;
    color: #90caf9;
    border-radius: 9px;
    padding: 2px 10px;
    font-weight: bold;
}

QWidget#weekHeader QLabel#weekConflicts {
    background-color: #5c2a2c;
    color: #ffcdd2;
    border-radius: 9px;
    padding: 2px 10px;
    font-weight: bold;
}
