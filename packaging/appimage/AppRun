#!/bin/sh
# Точка входа AppImage: база и данные — в ~/.local/share/cerastilo
HERE="$(dirname "$(readlink -f "$0")")"
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/cerastilo"
mkdir -p "$DATA_DIR"
export DB_PATH="$DATA_DIR/scheduler.db"
cd "$DATA_DIR" || exit 1
exec "$HERE/usr/lib/cerastilo/cerastilo" "$@"
